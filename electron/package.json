{
  "name": "aleym",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "io.github.NezarAltarouti.AlyemUI",
    "productName": "Aleym",
    "icon": "icon.png",
    "mac": {
      "identity": null,
      "target": "zip"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "executableName": "Aleym"
    },
   "extraResources": [
  {
    "from": "./bin/",
    "to": ".",
    "filter": ["aleym_api*"]
  }
    ]
  }
}