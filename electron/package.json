{
  "name": "aleym",
  "version": "1.0.2",
  "main": "main.js",
  "description": "News Aggregation and Knowledge-base System",
  "author": {"name": "Aleym Team"},
  "scripts": {
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "io.github.NezarAltarouti.Aleym",
    "productName": "Aleym",
    "icon": "icons/icon.png",
    "mac": {
      "identity": null,
      "target": {
        "target": "dmg",
        "arch": ["x64"]
      }
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "executableName": "aleym",
      "category": "Internet",
      "icon": "icons",
      "desktop": {
        "entry": {
        "Name": "Aleym Electron UI",
        "Comment": "News Aggregation and Knowledge-base System",
        "GenericName": "News Aggregator",
        "Categories": "Network;",
        "Keywords": "rss;atom;json;tor;privacy;",
        "StartupWMClass": "aleym"
      }
    }
    
    },
    "extraResources": [
      {
        "from": "./bin/",
        "to": ".",
        "filter": ["aleym_api*"]
      }
    ]
  }
}